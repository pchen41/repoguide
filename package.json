{
  "name": "repoguide",
  "version": "0.1.0",
  "description": "Generate and update guide.md wiki pages for Git repositories.",
  "type": "module",
  "bin": {
    "repoguide": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "pack:smoke": "npm pack --dry-run"
  },
  "dependencies": {
    "commander": "^14.0.2",
    "ignore": "^7.0.5",
    "openai": "^6.9.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.0.14",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  }
}
